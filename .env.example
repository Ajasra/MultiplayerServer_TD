# ──────────────────────────────────────────
# Game Server Environment Configuration
# Copy this file to .env and adjust as needed
# ──────────────────────────────────────────

# Server
NODE_ENV=development
PORT=3031

# Database (SQLite file path)
SQLITE_DB_PATH=./.sqlite-data/app.db

# CORS origin for WebSocket (use '*' for all origins)
# Set to your domain in production, e.g. https://game.example.com
CORS_ORIGIN=*

# React dev server URL (used when NODE_ENV !== production)
REACT_DEV_SERVER=http://localhost:3032

# React base URL for production redirects
REACT_BASE_URL=http://localhost

# Timezone
TZ=UTC

# Debug mode (enables verbose logging)
DEBUG_MODE=false
