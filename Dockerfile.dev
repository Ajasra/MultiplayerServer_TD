# Use an official Node.js runtime as a parent image
FROM node:20-alpine

# Set the working directory in the container
WORKDIR /usr/src/app

# Copy package.json and package-lock.json FIRST
# This helps with Docker's build caching
COPY package*.json ./

# Install all app dependencies (including dev dependencies)
RUN npm install --legacy-peer-deps

# Copy the rest of the application code.
# While docker-compose will mount the volume, this is good practice
# to ensure the image can be built and run independently if needed.
COPY . .

# Expose ports for the app and the dev server
EXPOSE 3031
EXPOSE 3032

# The default command will be overridden by docker-compose.dev.yml,
# but it's good to have a sensible default.
CMD [ "npm", "run", "dev" ] 