# Ignore node_modules directory, as dependencies are installed inside the container
node_modules

# Ignore Git files
.git
.gitignore

# Ignore Docker related files
Dockerfile
.dockerignore
docker-compose.yml

# Ignore environment files (should be passed via environment variables)
.env*

# Ignore npm debug logs
npm-debug.log*
npm-error.log*

# Ignore OS-specific files
.DS_Store
Thumbs.db

# Ignore IDE/editor specific files
.vscode/
.idea/

# Ignore build output (if any)
dist/
build/

# Ignore test reports (if any)
coverage/ 